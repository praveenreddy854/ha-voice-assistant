  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "build": "tsc && node scripts/copy-prompts.js",
    "dev": "npm run build && nodemon --watch src --exec 'node --inspect=0.0.0.0:9229 -r ts-node/register' src/index.ts",
