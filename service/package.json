{
  "name": "service",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "predev": "node scripts/download-models.js",
    "prebuild": "node scripts/download-models.js",
    "build": "tsc && node scripts/copy-prompts.js",
    "dev": "npm run build && nodemon --watch src --exec tsx src/index.ts",
    "dev:debug": "node scripts/download-models.js && nodemon --watch src --exec 'tsx --inspect=0.0.0.0:9229' src/index.ts",
    "traces": "node trace-viewer.js",
    "traces:prompts": "node trace-viewer.js prompts",
    "traces:errors": "node trace-viewer.js errors",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@ai-sdk/azure": "^4.0.52",
    "@azure/core-auth": "^1.11.0",
    "@azure/cosmos": "^4.10.0",
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-fs": "^0.40.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^7.0.83",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
