# Core server
PORT=3005
JSON_BODY_LIMIT=15mb

# Azure OpenAI (Vercel AI SDK)
AZURE_OPENAI_API_KEY=<replace>
AZURE_OPENAI_ENDPOINT=https://<azure-openai-resource>.openai.azure.com/openai/v1/
OPENAI_RESPONSES_API_VERSION=preview
AZURE_OPENAI_API_DEPLOYMENT_NAME=<replace>
HA_COMMAND_PROCESS_MODEL=<replace>
AZURE_OPENAI_MODEL_ADVANCED=<replace>
AZURE_AI_AGENT_MODEL=<replace>
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=<replace>
HOME_ASSISTANT_DEVICES=<replace_comma_separated_device_prefixes>
HOME_ASSISTANT_SKILL_MATCHERS=<replace_json_mapping>
TV_DEFAULT_WAIT_MS=1500
TV_AGENT_DEVICES=<replace_comma_separated_device_names>

# Daily home checks (optional)
VACUUM_CLEANER_ENTITY_ID=<replace_entity_id>
LAUNDRY_SWITCH_ENTITY_ID=<replace_entity_id>
HOME_ASSISTANT_NOTIFY_SERVICE=notify/notify
HOME_CHECKS_ENABLED=true
HOME_CHECKS_CRON="0 9 * * *"
LAUNDRY_ALERT_MINUTES=50

# Agent loop tuning (optional)
TV_AGENT_MAX_ITERATIONS=8
TV_AGENT_MIN_RUN_INTERVAL_MS=3000
NAV_AGENT_MAX_ITERATIONS=12
NAV_AGENT_MIN_RUN_INTERVAL_MS=2000
TYPING_AGENT_MAX_ITERATIONS=15
TYPING_AGENT_MIN_RUN_INTERVAL_MS=1500

# Speech (optional)
AZURE_SPEECH_KEY=<replace>
AZURE_SPEECH_REGION=eastus

# Device state logging to Cosmos DB (optional)
AZURE_COSMOS_ENDPOINT=<replace>
AZURE_COSMOS_KEY=<replace>
AZURE_COSMOS_DATABASE=<replace>
AZURE_COSMOS_CONTAINER=<replace>
DEVICE_STATE_LOG_CRON="0 * * * *"

# Teaching mode screenshot storage (optional)
AZURE_STORAGE_ACCOUNT_NAME=<replace>
AZURE_STORAGE_ACCOUNT_KEY=<replace>
AZURE_STORAGE_CONTAINER_NAME=<replace>

# OpenTelemetry export (optional)
OTEL_SERVICE_NAME=<replace_service_name>
OTEL_EXPORT_MODE=file
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
OTEL_METRIC_EXPORT_TIMEOUT_MS=5000
