# Fill these in only in service/.env. See src/modelCatalog.ts for deployment routing.
AZURE_OPENAI_RESOURCE_NAME_EUS=""
AZURE_OPENAI_API_KEY_EUS=""
AZURE_OPENAI_RESOURCE_NAME_EUS2=""
AZURE_OPENAI_API_KEY_EUS2=""
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Keep the model used to generate existing memory, TV flow, and teaching embeddings.
EMBEDDING_MODEL=text-embedding-3-large
GPT_LIVE_VOICE=marin

PORT=3005

# Apple Shortcut (unauthenticated, LAN-only v1)
# Use a local hostname or LAN IP and do not expose this service publicly.
APPLE_SHORTCUT_BASE_URL=http://ha-service.home.arpa:3005

# Azure Speech Service
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=eastus

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_DEVICES=""
# Include every control referenced by applicable scoped memory or user requests.
# See docs/home-assistant-memory.md for device-specific guidance and sequences.
VACUUM_CLEANER_ENTITY_ID=""
TV_DEFAULT_WAIT_MS=1500
# Per-key remote delay; 0 overrides Home Assistant's 400ms Apple TV default.
# Increase slightly only if your device misses fast key presses.
TV_REMOTE_KEY_DELAY_MS=0
TV_AGENT_DEVICES=""

# Azure Cosmos DB (device state logging)
AZURE_COSMOS_ENDPOINT=""
AZURE_COSMOS_KEY=""
AZURE_COSMOS_DATABASE="HomeAssistant"
AZURE_COSMOS_CONTAINER="DeviceStates"
DEVICE_STATE_LOG_CRON="0 * * * *"
AZURE_COSMOS_TV_FLOW_CONTAINER="TVAgentFlowMemory"
TV_FLOW_MEMORY_MIN_SIMILARITY=0.65
TV_FLOW_MEMORY_TOP_K=5
AZURE_COSMOS_MEMORY_CONTAINER="AgentMemory"
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_TIMEOUT_MS=900
MEMORY_MIN_SIMILARITY=0.55
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_INTERVAL_MS=60000

# Camera Source
CAMERA_ON_DEVICE=true              # true = client webcam, false = RTSP stream
RTSP_URL=""                        # e.g. rtsp://192.168.1.100:554/stream
RTSP_USERNAME=""
RTSP_PASSWORD=""

# Optional gesture detection (RTSP only). Run npm run gesture:setup first.
GESTURE_ENABLED=true
# GESTURE_PYTHON=/absolute/path/to/python
# GESTURE_SETUP_PYTHON=python3

# Azure Blob Storage (teaching mode screenshots)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME="ftimages"

# Offline evaluations run in a separate process on this backend's host.
# Daily simulated suite: 03:00 America/New_York; recorded runs are on demand.
OFFLINE_EVAL_ENABLED=true
# Optional: defaults to service/generated_data/offline-evals (local, isolated storage).
OFFLINE_EVAL_DIR=
