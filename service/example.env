# Azure OpenAI
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_RESOURCE_NAME=""
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Three-Tier Model System
AI_MODEL_NANO=gpt-4o-mini          # Intent classification, simple JSON
AI_MODEL_MINI=gpt-4o-mini          # HA commands, vision helpers
AI_MODEL_ADVANCED=gpt-4o           # Agent loops (TV, navigation, typing)

PORT=3005

# Azure Speech Service
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=eastus

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_DEVICES=""
TV_DEFAULT_WAIT_MS=1500
TV_AGENT_DEVICES=""

# Azure Cosmos DB (device state logging)
AZURE_COSMOS_ENDPOINT=""
AZURE_COSMOS_KEY=""
AZURE_COSMOS_DATABASE=""
AZURE_COSMOS_CONTAINER=""
DEVICE_STATE_LOG_CRON="0 * * * *"

# Azure Blob Storage (teaching mode screenshots)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME=""
