# Azure OpenAI API Key
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_SESSIONS_URL=""
PORT=3005
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=eastus
AZURE_OPENAI_COMPLETION_URL="https://<domain>/openai/deployments/gpt-4.1-nano/chat/completions?api-version=2025-01-01-preview"
AZURE_OPENAI_API_INSTANCE_NAME=""
AZURE_OPENAI_API_DEPLOYMENT_NAME=model-router
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_MODEL=model-router
AZURE_OPENAI_API_DEPLOYMENT_NAME_ADVANCED=gpt-4.1-nano
AZURE_OPENAI_MODEL_ADVANCED=gpt-4.1-nano
OPENAI_RESPONSES_API_VERSION=preview

# Home Assistant configuration
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_DEVICES=""
# Camera screenshots are captured by the client app on the local machine
TV_DEFAULT_WAIT_MS=1500

# Azure Cosmos DB configuration for device state logging
AZURE_COSMOS_ENDPOINT=""
AZURE_COSMOS_KEY=""
AZURE_COSMOS_DATABASE=""
AZURE_COSMOS_CONTAINER=""
# Optional: override the cron expression (default runs at the top of every hour)
DEVICE_STATE_LOG_CRON="0 * * * *"

# Agents
AZURE_AI_PROJECT_ENDPOINT=""
AZURE_AI_AGENT_MODEL=""
export AZURE_TENANT_ID=""
export AZURE_CLIENT_ID=""
export AZURE_CLIENT_SECRET=""

TV_AGENT_MAX_ITERATIONS=""
# Minimum delay between Azure run creations in milliseconds (default ~1.2s)
TV_AGENT_MIN_RUN_INTERVAL_MS=""
# Azure AI Agents retry configuration for network resilience
# Maximum number of retries for Azure API calls (default 3)
AZURE_AGENTS_MAX_RETRIES=""
# Base delay in milliseconds between retries, with exponential backoff (default 1000)
AZURE_AGENTS_BASE_RETRY_DELAY=""
# Enable/disable retry logic for Azure API calls (default true)
AZURE_AGENTS_RETRY_ENABLED=""
# Timeout for Azure API calls in milliseconds (default 30000 = 30 seconds)
AZURE_AGENTS_TIMEOUT_MS=""
TV_AGENT_DEVICES=""

# Azure Blob Storage for Teaching Mode screenshots
# Screenshots are uploaded to blob storage and URLs are used in training data (JSONL)
# instead of base64 strings for better fine-tuning compatibility
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME=""
