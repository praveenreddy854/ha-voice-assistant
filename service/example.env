# Azure OpenAI
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_RESOURCE_NAME=""
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Three-Tier Model System
AI_MODEL_NANO=gpt-5.4-nano         # Simple JSON extraction
AI_MODEL_MINI=gpt-5.4-mini         # HA commands, vision helpers
AI_MODEL_ADVANCED=gpt-5.4         # Agent loops (TV, navigation, typing)
AI_MODEL_REALTIME=gpt-realtime     # Post-wake-word voice agent
AI_MODEL_TRANSCRIBE=whisper-1      # Realtime input transcript model/deployment
EMBEDDING_MODEL=text-embedding-3-large

PORT=3005

# Azure Speech Service
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=eastus

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_DEVICES=""
VACUUM_CLEANER_ENTITY_ID=""
TV_DEFAULT_WAIT_MS=1500
# Per-key remote delay; 0 overrides Home Assistant's 400ms Apple TV default.
# Increase slightly only if your device misses fast key presses.
TV_REMOTE_KEY_DELAY_MS=0
TV_AGENT_DEVICES=""

# Azure Cosmos DB (device state logging)
AZURE_COSMOS_ENDPOINT=""
AZURE_COSMOS_KEY=""
AZURE_COSMOS_DATABASE="HomeAssistant"
AZURE_COSMOS_CONTAINER="DeviceStates"
DEVICE_STATE_LOG_CRON="0 * * * *"
AZURE_COSMOS_TV_FLOW_CONTAINER="TVAgentFlowMemory"
TV_FLOW_MEMORY_MIN_SIMILARITY=0.65
TV_FLOW_MEMORY_TOP_K=5
AZURE_COSMOS_MEMORY_CONTAINER="AgentMemory"
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_TIMEOUT_MS=900
MEMORY_MIN_SIMILARITY=0.55
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_INTERVAL_MS=60000

# Camera Source
CAMERA_ON_DEVICE=true              # true = client webcam, false = RTSP stream
RTSP_URL=""                        # e.g. rtsp://192.168.1.100:554/stream
RTSP_USERNAME=""
RTSP_PASSWORD=""

# Azure Blob Storage (teaching mode screenshots)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME="ftimages"
