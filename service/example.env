# Azure OpenAI API Key
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_SESSIONS_URL=""
PORT=3005
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=eastus
AZURE_OPENAI_COMPLETION_URL="https://<domain>/openai/deployments/gpt-4.1-nano/chat/completions?api-version=2025-01-01-preview"
AZURE_OPENAI_API_INSTANCE_NAME=""
AZURE_OPENAI_API_DEPLOYMENT_NAME=gpt-4.1-nano
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_MODEL=gpt-4.1-nano
AZURE_OPENAI_API_DEPLOYMENT_NAME_ADVANCED=gpt-4.1-nano
AZURE_OPENAI_MODEL_ADVANCED=gpt-4.1-nano
OPENAI_RESPONSES_API_VERSION=preview

# Home Assistant configuration
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_DEVICES=appletv,samsung_tv,roborock_s7,laundry_switch
TV_REMOTE_ENTITY_ID="remote.living_room_tv"
# Camera screenshots are captured by the client app on the local machine
TV_DEFAULT_WAIT_MS=1500

# Azure Cosmos DB configuration for device state logging
AZURE_COSMOS_ENDPOINT=""
AZURE_COSMOS_KEY=""
AZURE_COSMOS_DATABASE=""
AZURE_COSMOS_CONTAINER=""
# Optional: override the cron expression (default runs at the top of every hour)
DEVICE_STATE_LOG_CRON="0 * * * *"

OPENAI_BASE_URL=""
AZURE_AI_AGENT_ENDPOINT="https://<your-agent-resource>.cognitiveservices.azure.com"
AZURE_AI_AGENT_KEY=""
AZURE_AI_AGENT_MODEL=gpt-4o-mini
